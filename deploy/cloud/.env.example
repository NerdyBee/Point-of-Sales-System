# The web address for this client, e.g. pos.bellafoods.com. Point its DNS A record at
# this server's IP first; Caddy then gets an HTTPS certificate automatically.
DOMAIN=pos.example.com
# Long random passwords (letters and digits only). Keep them; you need them for restores.
DB_ROOT_PASSWORD=change-me-root
DB_PASSWORD=change-me-app
