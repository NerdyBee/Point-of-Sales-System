{
  "name": "pos-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm --workspace apps/admin-web run dev",
    "dev:api": "npm --workspace server/api run dev",
    "build": "npm --workspaces --if-present run build",
    "test": "npm --workspaces --if-present run test",
    "db:generate": "prisma generate --schema database/prisma/schema.prisma",
    "db:push": "prisma db push --schema database/prisma/schema.prisma",
    "db:seed": "tsx database/seed.ts",
    "db:reset": "prisma db push --force-reset --schema database/prisma/schema.prisma && tsx database/seed.ts"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "server/*"
  ],
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.0.3",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "mariadb": "^3.5.3",
    "morgan": "^1.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  }
}
