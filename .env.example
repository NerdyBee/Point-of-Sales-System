DATABASE_URL="mysql://root:your_password@localhost:3306/naijapos"

# --- Replication (see SYNC_ARCHITECTURE.md) ---------------------------------
# cloud  = the online server for this business (default)
# office = the server installed in the shop/office; works fully offline and can
#          optionally sync with the cloud (connect it from Admin > Sync).
NODE_ROLE=cloud
# Optional fixed name for this server in sync logs/admin (generated if empty).
# NODE_ID=office-ikeja
# Optional short code put into sale numbers (INV-<CODE>-00001). Offices get a
# random one automatically; the cloud keeps INV-00001 numbering unless set.
# NODE_CODE=IKJ1
# How often an office pushes/pulls with the cloud (milliseconds).
# SYNC_INTERVAL_MS=30000
# Listen on all interfaces so tablets on the shop Wi-Fi can reach the office server.
# HOST=0.0.0.0
